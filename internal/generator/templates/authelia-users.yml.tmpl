# Authelia Users Database
# Generated by sdbx init
#
# To generate a password hash, run:
#   docker run --rm authelia/authelia:latest authelia crypto hash generate argon2
#
# The administrator name and Argon2id password hash come from sdbx init.

users:
  {{ yamlQuote .Config.AdminUser }}:
    displayname: "Admin"
    # Password set during init (Argon2id hash)
    password: {{ yamlQuote .Config.AdminPasswordHash }}
    email: {{ yamlQuote (printf "%s@%s" .Config.AdminUser .Config.Domain) }}
    groups:
      - admins
      - users
