# Traefik Static Configuration
# Generated by sdbx init

global:
  checkNewVersion: false
  sendAnonymousUsage: false

api:
  dashboard: false
  insecure: false

ping:
  entryPoint: traefik

entryPoints:
  web:
    address: ":80"
    forwardedHeaders:
      # No direct client or upstream proxy is trusted to supply forwarding
      # metadata. Traefik strips hostile values before middleware execution.
      trustedIPs: []
    transport:
      respondingTimeouts:
        readTimeout: 60s
        writeTimeout: 0s
        idleTimeout: 180s
    http:
      maxHeaderBytes: 32768
      sanitizePath: true
{{- if or (eq .Config.Expose.Mode "lan") (eq .Config.Expose.Mode "direct")}}
      redirections:
        entryPoint:
          to: websecure
          scheme: https
{{- end}}

  websecure:
    address: ":443"
    forwardedHeaders:
      # ForwardAuth may consume only the forwarding metadata synthesized by
      # Traefik itself or by an earlier generated middleware.
      trustedIPs: []
    transport:
      respondingTimeouts:
        readTimeout: 60s
        writeTimeout: 0s
        idleTimeout: 180s
    http:
      maxHeaderBytes: 32768
      sanitizePath: true
{{- if eq .Config.Expose.Mode "lan"}}
      tls: {}
{{- end}}
{{- if eq .Config.Expose.Mode "direct"}}
      tls:
        certResolver: letsencrypt
{{- end}}

{{- if eq .Config.Expose.Mode "cloudflared"}}
  # Dedicated, container-only tunnel ingress. Client-supplied forwarding
  # headers remain untrusted; the generated file-provider middleware restores
  # only the HTTPS scheme metadata guaranteed by the Cloudflare Tunnel.
  tunnel:
    address: ":8081"
    forwardedHeaders:
      # cloudflared is intentionally not trusted for arbitrary forwarding
      # headers. The generated middleware restores only HTTPS scheme metadata.
      trustedIPs: []
    transport:
      respondingTimeouts:
        readTimeout: 60s
        writeTimeout: 0s
        idleTimeout: 180s
    http:
      maxHeaderBytes: 32768
      sanitizePath: true
{{- end}}

  traefik:
    address: ":8080"

{{- if eq .Config.Expose.Mode "direct"}}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ yamlQuote .Config.Expose.TLS.Email }}
      storage: /acme.json
      httpChallenge:
        entryPoint: web
{{- end}}

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: INFO
  format: json

accessLog:
  format: json
  fields:
    defaultMode: keep
    headers:
      defaultMode: drop
    queryParameters:
      defaultMode: drop

serversTransport:
  forwardingTimeouts:
    dialTimeout: 10s
    responseHeaderTimeout: 30s
    idleConnTimeout: 90s
