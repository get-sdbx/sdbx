# Absolute path to exactly one initialized and lock-verified SDBX project.
SDBX_PROJECT_DIR=/srv/sdbx/project

# Optional absolute source configuration. Leave empty for the embedded catalog.
SDBX_SOURCES_FILE=

# Optional direct broker clients may use Authelia OIDC. Set both values or
# leave both empty. The bundled Web console uses Authelia at the generated
# Traefik boundary and the local client token only for its broker hop.
SDBX_OIDC_ISSUER=
SDBX_OIDC_CLIENT_ID=
